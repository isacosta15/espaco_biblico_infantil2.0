# Copie para .env (local) ou cadastre estas variáveis na Vercel
# (Project → Settings → Environment Variables).

# Postgres (ex.: Neon, Supabase, Vercel Postgres). Use a URL "pooled" se existir.
DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require

# Segredo usado para assinar os tokens de login. OBRIGATÓRIO em produção.
# Gere um valor aleatório:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Usados apenas pelo comando de seed (cria/atualiza o usuário administrador):
#   pnpm --filter @workspace/api-server run seed
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador
